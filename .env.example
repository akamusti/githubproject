# Optional: GitHub Personal Access Token (increases rate limit from 60 to 5000 req/hour)
# Create one at https://github.com/settings/tokens with `read:user` and `public_repo` scopes.
GITHUB_TOKEN=

# GitHub OAuth App credentials (for "Login with GitHub")
# Create an OAuth App at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Session signing secret (change in production)
SESSION_SECRET=change-me-in-production

PORT=3000